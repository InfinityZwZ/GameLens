LLM_API_KEY=
LLM_MODEL=qwen3.8-flash
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_TIMEOUT=180
LLM_MAX_RETRIES=3
# Whole-task budgets. Every HTTP attempt, retry, format fallback and screening
# request consumes one shared SQLite-reserved slot.
AGENT_LLM_REQUEST_LIMIT=32
AGENT_ACTIVE_SECONDS_LIMIT=1800
# Per-call total wait/retry deadline; do not repeat 180s waits indefinitely.
LLM_REQUEST_DEADLINE=240
# Auto: documented DashScope Qwen 3.8/3.7 mixed models use non-thinking SSE.
# Other models/providers keep their original behaviour. Explicit true/false overrides.
LLM_ENABLE_THINKING=auto
LLM_STREAMING=auto
# Maximum idle wait between stream chunks, not the total Agent duration.
LLM_STREAM_READ_TIMEOUT=30
# Budgets include provider-counted reasoning tokens, if any. 0 uses safe defaults.
# Truncated JSON is rejected, never treated as a complete answer.
LLM_MAX_OUTPUT_TOKENS=4096
LLM_PLANNER_MAX_TOKENS=3072
LLM_FINAL_MAX_TOKENS=4096
LLM_SCREEN_MAX_TOKENS=4096
LLM_REPAIR_MAX_TOKENS=3072
# Optional: your provider's price per million tokens; blank means unknown cost.
LLM_INPUT_PRICE_PER_MILLION=
LLM_OUTPUT_PRICE_PER_MILLION=
LLM_PRICE_CURRENCY=CNY
